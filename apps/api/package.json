{
	"name": "api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/main.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/main.js",
		"check-types": "tsc --noEmit",
		"test": "jest",
		"db:generate": "prisma generate",
