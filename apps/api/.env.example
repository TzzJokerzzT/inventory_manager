# apps/api environment variables.
# Copy this file to .env and fill in the values you need. Never commit real secrets.

# HTTP server
PORT=3001
NODE_ENV=development

# Database — Prisma + Supabase (see docs/stack.md §3).
# DATABASE_URL is the pooled URL (Supabase pooler, port 6543, with ?pgbouncer=true);
# it is used by the runtime Prisma client through the pg driver adapter.
# DIRECT_URL is the direct/session-pooler URL (port 5432); it is used by the
# Prisma CLI and by migrations only.
DATABASE_URL=
DIRECT_URL=

# Auth0 JWT validation (pending — see docs/stack.md 5.4)
# AUTH0_DOMAIN=
# AUTH0_AUDIENCE=
