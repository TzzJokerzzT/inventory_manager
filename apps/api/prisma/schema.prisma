// TODO(migrations): nothing applies migrations to the deployed database. CI runs
// `db:deploy` against an ephemeral Postgres only (see .github/workflows/ci.yml),
// and the API's build is just `tsc`, so a new model declared here reaches
// production as a missing table: the Prisma client knows it, the suites pass
// (they use in-memory doubles), and every query on it answers 500. Until a
// deploy step runs `prisma migrate deploy` (see docs/stack.md §3.3), applying a
// migration is a manual, required step:
//
//   cd apps/api && bun run db:deploy

generator client {
	provider = "prisma-client"
	output   = "../src/infrastructure/database/generated/prisma"
}

datasource db {
	provider = "postgresql"
}

enum MembershipRole {
	OWNER
	ADMIN
	MEMBER
}

enum MembershipStatus {
	INVITED
	ACTIVE
	REVOKED
}

enum StockMovementType {
	IN
	OUT
}

// Every relation uses `onDelete: Restrict` because this schema never
// hard-deletes: products and customers soft-delete, memberships revoke via
// `status = REVOKED`, and the `stock_movements` audit trail must stay
// readable (MOV-05). Orphaned rows must be impossible at the database level.

model Company {
	id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	name      String
	taxId     String?  @map("tax_id")
	address   String?
	phone     String?
	createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
	updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

	memberships Membership[]
	categories  Category[]
	products    Product[]
	customers   Customer[]
	movements   StockMovement[]

	@@map("companies")
}

model User {
	id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	auth0Sub  String   @unique @map("auth0_sub")
	// Stored lowercased: it is the join key matched against
	// `memberships.invited_email`, enforced by a hand-added CHECK in the first
	// migration (T4).
	email     String   @unique
	fullName  String?  @map("full_name")
	createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
	updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

	memberships        Membership[]    @relation("MembershipUser")
	invitedMemberships Membership[]    @relation("InvitedBy")
	movements          StockMovement[]
	notifications      Notification[]

	@@map("users")
}

model Membership {
	id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	userId       String?          @map("user_id") @db.Uuid
	// Stored lowercased: it is the join key matched against `users.email`,
	// enforced by a hand-added CHECK in the first migration (T4).
	invitedEmail String           @map("invited_email")
	companyId    String           @map("company_id") @db.Uuid
	role         MembershipRole
	status       MembershipStatus @default(INVITED)
	invitedBy    String           @map("invited_by") @db.Uuid
	acceptedAt   DateTime?        @map("accepted_at") @db.Timestamptz(3)
	createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
	updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

	user    User?   @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)
	company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
	inviter User    @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: Restrict)

	// NULLs are distinct in PostgreSQL, so several pending invitations with
	// `user_id IS NULL` for the same company coexist — intentional: the
	// assignment exists before the account does.
	@@unique([userId, companyId])
	@@index([invitedEmail, status])
	@@index([companyId, status])
	@@map("memberships")
}

model Category {
	id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	companyId String   @map("company_id") @db.Uuid
	name      String
	createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
	updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

	company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
	products Product[]

	@@unique([companyId, name])
	@@map("categories")
}

model Product {
	id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	companyId         String    @map("company_id") @db.Uuid
	name              String
	description       String?
	sku               String
	price             Decimal   @db.Decimal(12, 2)
	photoUrl          String?   @map("photo_url")
	stockQuantity     Int       @default(0) @map("stock_quantity")
	lowStockThreshold Int       @default(0) @map("low_stock_threshold")
	categoryId        String?   @map("category_id") @db.Uuid
	createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
	updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
	deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

	company   Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
	category  Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
	movements StockMovement[]

	@@unique([companyId, sku])
	@@index([companyId, deletedAt])
	@@index([companyId, categoryId])
	@@map("products")
}

model Customer {
	id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	companyId String   @map("company_id") @db.Uuid
	name      String
	email     String?
	phone     String?
	address   String?
	createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
	updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
	deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

	company   Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
	movements StockMovement[]

	@@index([companyId, deletedAt])
	@@map("customers")
}

// A notification is an *event* ("X accepted your invitation"), deliberately
// separate from `memberships`, which is *state* (a pending/active/revoked
// relation). `dedupe_key` carries the UNIQUE index that makes the write
// idempotent: a replayed accept must never record the event twice. `read_at`
// stays nullable, and NULL means unread. Rows are never hard-deleted by a
// scheduled job: the only deletion is the opportunistic 90-day purge the
// adapter runs when it writes a new notification.
model Notification {
	id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	userId    String    @map("user_id") @db.Uuid
	type      String
	payload   Json      @default("{}")
	dedupeKey String    @unique @map("dedupe_key")
	readAt    DateTime? @map("read_at") @db.Timestamptz(3)
	createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

	user User @relation(fields: [userId], references: [id], onDelete: Restrict)

	@@index([userId, createdAt(sort: Desc)])
	@@map("notifications")
}

model StockMovement {
	id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	companyId  String            @map("company_id") @db.Uuid
	productId  String            @map("product_id") @db.Uuid
	type       StockMovementType
	quantity   Int
	reason     String?
	userId     String            @map("user_id") @db.Uuid
	customerId String?           @map("customer_id") @db.Uuid
	createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

	company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
	product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
	user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
	customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

	@@index([companyId, productId, createdAt])
	@@index([companyId, customerId])
	@@map("stock_movements")
}
