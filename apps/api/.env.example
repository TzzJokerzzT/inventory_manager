# apps/api environment variables.
# Copy this file to .env and fill in the values you need. Never commit real secrets.

# HTTP server
PORT=3001
NODE_ENV=development

# Database — Prisma + Supabase (see docs/stack.md §3).
# DATABASE_URL is the pooled URL (Supabase pooler, port 6543, with ?pgbouncer=true);
# it is used by the runtime Prisma client through the pg driver adapter.
# DIRECT_URL is the direct/session-pooler URL (port 5432); it is used by the
# Prisma CLI and by migrations only.
DATABASE_URL=
DIRECT_URL=

# Auth0 (see docs/stack.md §5.4). The API validates the JWT against the tenant
# JWKS and mediates the credential exchange, so all five are required to boot.
# The tenant needs a Regular Web Application with the Password and Refresh Token
# grants enabled, and its Default Directory set to the connection below.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CONNECTION=

# Browser origin allowed to call the API with credentials (the refresh-token
# cookie lives there). Required in production; in development it falls back to
# http://localhost:3000. A wildcard is not an option: browsers reject it on
# credentialed requests.
WEB_ORIGIN=http://localhost:3000
