		"express-rate-limit": "^8.7.0",
		"express-validator": "^7.3.2",
		"helmet": "^8.3.0",
		"http-status-codes": "^2.3.0",
		"morgan": "^1.12.1",
		"pg": "^8.23.1",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@swc/jest": "^0.2.39",
