generator client {
	provider = "prisma-client"
	output   = "../src/infrastructure/database/generated/prisma"
}

datasource db {
	provider = "postgresql"
}

enum MembershipRole {
	OWNER
	ADMIN
	MEMBER
}

enum MembershipStatus {
	INVITED
	ACTIVE
	REVOKED
}

enum StockMovementType {
	IN
	OUT
}

// Every relation uses `onDelete: Restrict` because this schema never
// hard-deletes: products and customers soft-delete, memberships revoke via
// `status = REVOKED`, and the `stock_movements` audit trail must stay
// readable (MOV-05). Orphaned rows must be impossible at the database level.

model Company {
	id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	name      String
	taxId     String?  @map("tax_id")
	address   String?
	phone     String?
	createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
	updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

	memberships Membership[]
	categories  Category[]
	products    Product[]
	customers   Customer[]
	movements   StockMovement[]

	@@map("companies")
}

model User {
	id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	auth0Sub  String   @unique @map("auth0_sub")
	// Stored lowercased: it is the join key matched against
	// `memberships.invited_email`, enforced by a hand-added CHECK in the first
	// migration (T4).
	email     String   @unique
	fullName  String?  @map("full_name")
	createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
	updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

	memberships        Membership[]    @relation("MembershipUser")
	invitedMemberships Membership[]    @relation("InvitedBy")
	movements          StockMovement[]

	@@map("users")
}

model Membership {
	id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	userId       String?          @map("user_id") @db.Uuid
	// Stored lowercased: it is the join key matched against `users.email`,
	// enforced by a hand-added CHECK in the first migration (T4).
	invitedEmail String           @map("invited_email")
	companyId    String           @map("company_id") @db.Uuid
	role         MembershipRole
	status       MembershipStatus @default(INVITED)
	invitedBy    String           @map("invited_by") @db.Uuid
	acceptedAt   DateTime?        @map("accepted_at") @db.Timestamptz(3)
	createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
	updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

	user    User?   @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)
	company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
	inviter User    @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: Restrict)

	// NULLs are distinct in PostgreSQL, so several pending invitations with
	// `user_id IS NULL` for the same company coexist — intentional: the
	// assignment exists before the account does.
	@@unique([userId, companyId])
	@@index([invitedEmail, status])
	@@index([companyId, status])
	@@map("memberships")
}

model Category {
	id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	companyId String   @map("company_id") @db.Uuid
	name      String
	createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
	updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

	company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
	products Product[]

	@@unique([companyId, name])
	@@map("categories")
}

model Product {
	id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	companyId         String    @map("company_id") @db.Uuid
	name              String
	description       String?
	sku               String
	price             Decimal   @db.Decimal(12, 2)
	photoUrl          String?   @map("photo_url")
	stockQuantity     Int       @default(0) @map("stock_quantity")
	lowStockThreshold Int       @default(0) @map("low_stock_threshold")
	categoryId        String?   @map("category_id") @db.Uuid
	createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
	updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
	deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

	company   Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
	category  Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
	movements StockMovement[]

	@@unique([companyId, sku])
	@@index([companyId, deletedAt])
	@@index([companyId, categoryId])
	@@map("products")
}

model Customer {
	id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	companyId String   @map("company_id") @db.Uuid
	name      String
	email     String?
	phone     String?
	address   String?
	createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
	updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
	deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

	company   Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
	movements StockMovement[]

	@@index([companyId, deletedAt])
	@@map("customers")
}

model StockMovement {
	id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
	companyId  String            @map("company_id") @db.Uuid
	productId  String            @map("product_id") @db.Uuid
	type       StockMovementType
	quantity   Int
	reason     String?
	userId     String            @map("user_id") @db.Uuid
	customerId String?           @map("customer_id") @db.Uuid
	createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

	company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
	product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
	user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
	customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

	@@index([companyId, productId, createdAt])
	@@index([companyId, customerId])
	@@map("stock_movements")
}
