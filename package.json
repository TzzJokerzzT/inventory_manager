{
	"name": "inventory-manager",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "biome check .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"prepare": "husky",
		"check-types": "turbo run check-types",
		"test": "turbo run test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"husky": "^9.1.7",
		"turbo": "^2.11.4",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=24"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.2"
		}
	},
	"workspaces": [
		"apps/*"
	]
}
