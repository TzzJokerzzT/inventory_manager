# Environment variables for the monorepo.
#
# Copy this file to .env (or export the values in your shell) and fill in the
# placeholders. Never commit real values: secrets live only in your local
# environment and in the deploy provider.
#
# Each app also ships its own example next to it:
#   apps/api/.env.example
#   apps/web/.env.example
# This file is the monorepo view: every variable the code reads, in one place.

# ===========================================================================
# API runtime
# ===========================================================================
# The API reads these through apps/api/src/config/env.ts.
# Port the API listens on. Optional; defaults to 3001.
PORT=3001

# "development" | "production" | "test". Optional; defaults to development.
# Usually the runtime or the tooling sets this, so it is listed for reference
# rather than to be filled in.
# NODE_ENV=development

# Browser origin allowed to call the API with credentials. It has to be an
# explicit origin: the refresh cookie is httpOnly and credentialed requests
# are rejected when the origin is a wildcard.
# Required in production; falls back to http://localhost:3000 in development.
WEB_ORIGIN=http://localhost:3000

# ===========================================================================
# Database
# ===========================================================================
# Supabase, two URLs on purpose.
# Pooled connection (port 6543, pgbouncer): what the API uses at runtime.
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/<database>?pgbouncer=true
# Direct connection (port 5432): what the Prisma CLI and the migrations use,
# because they cannot run through a transaction pooler.
DIRECT_URL=postgresql://<user>:<password>@<host>:5432/<database>

# ===========================================================================
# Auth0
# ===========================================================================
# The API exchanges credentials with Auth0 server to server (ROPG) and
# validates access tokens against the tenant JWKS.
AUTH0_DOMAIN=<your-tenant>.auth0.com
AUTH0_AUDIENCE=https://inventory-manager-api
AUTH0_CLIENT_ID=<value-of-the-Regular-Web-Application>
# SECRET: never commit it, never log it.
AUTH0_CLIENT_SECRET=<value-of-the-Regular-Web-Application>
# Database connection inside Auth0. The ROPG flow also needs the tenant's
# Default Directory set to this same name, otherwise Auth0 answers 500.
AUTH0_CONNECTION=Username-Password-Authentication

# ===========================================================================
# Frontend
# ===========================================================================
# Base URL of the API as the browser reaches it. `NEXT_PUBLIC_` values are
# inlined into the client bundle, so this one must never hold a secret.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ===========================================================================
# Cloudinary
# ===========================================================================
# Signed direct upload: the API signs and the browser uploads straight to the
# provider, so no image travels through the server.
# NOTE: no code reads these yet; they are wired by MI-40.
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
# SECRET: never commit it, never log it.
CLOUDINARY_API_SECRET=<api-secret>
