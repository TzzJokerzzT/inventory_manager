{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node"],
		"strict": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,
		"noEmitOnError": true,
		// The web project imports the compiled app, so the types travel with it.
		"declaration": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
