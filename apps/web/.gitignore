# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*
# The template carries no secrets and is what a new clone copies to .env.local,
# so it stays versioned — same rule as apps/api/.env.example. A nested
# .gitignore wins over the repository root's negation, so it has to be here.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
